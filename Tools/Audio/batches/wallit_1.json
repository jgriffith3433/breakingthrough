"lines": [
{
"who": "wallit",
"text": "A door number. Does it come with a door?",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "And the bolts they drop?",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "And the plates? The big ones?",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "And then?",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "Bolts. Somebody's paying me.",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "By the guy with the stamp.",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "Cleared things. Somebody's hat. Somebody's clock. That could be me.",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "Cover me, Slice. I'm collecting a refund.",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "Does existing come with a receipt?",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "Door's down. Still no sender.",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "Every bot that's come at us. They're coming from down there.",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "Every page turned over. DENIED.",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "Evidence. Every bill has a paper trail.",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "Feed's broken. Their pay is mine now.",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "Flat. Every one. Pay up.",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "Guard Slice. Swing at anything chirpy. Pay up.",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "Hello? Sender? I'd like a word, and a receipt.",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "I am.",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "I've seen it. I don't need to be told.",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "It's filed. All of it.",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "It's got my notice in there somewhere. I keep receipts.",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "It's not signed.",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "It's watching the circle.",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "It waited for me to take it. Three times. Refused all three.",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "Last of the Crew. Then the big one. Exact change.",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "Leased. By you.",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "Locks have keys. Keys have owners. Owners get paid.",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "Meaning?",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "My stamp. My door.",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "Neither do I. Pay up.",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "Nerve's free. The swing's extra.",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "Next time I'm billing the Floor.",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "No.",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "Nobody signs it. That's the whole trick.",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "None of this is mine. I'm keeping it anyway.",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "Not for free.",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "Nothing. Not even a doormat. I'd say that's rude, but I'm the one with no address.",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "Nothing's free.",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "One lever. No sign. Somebody trusts the floor.",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "One notice, returned. Where's my tip?",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "Open up. I know you're in there. It's a stamp, not a person.",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "Overhead. Don't look at me like that.",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "Pages four and five are the small print. Nobody reads the small print. I do.",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "Read what?",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "Received. In full. Pay up.",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "Refused.",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "Refused. I can do refused. Free of charge.",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "Refused the paper three times. Put that in writing.",
"direction": "brash, angry, money-minded"
},
{
"who": "wallit",
"text": "Return to sender.",
"direction": "brash, angry, money-minded"
}
]
}